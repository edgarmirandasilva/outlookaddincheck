{
  "name": "outlook-addin-followup",
  "version": "1.0.0",
  "description": "Outlook add-in for managing email follow-ups with IMAP support",
  "main": "index.js",
  "scripts": {
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "dev-server": "webpack serve --mode development",
    "build": "webpack --mode production"
  },
  "keywords": [
    "outlook",
    "office-add-in",
    "follow-up",
    "email",
    "imap"
  ],
  "author": "Edgar Miranda Silva",
  "license": "MIT",
  "dependencies": {
    "@microsoft/office-js": "^1.1.91",
    "@microsoft/office-js-helpers": "^1.0.2"
  },
  "devDependencies": {
    "office-addin-debugging": "^5.0.0",
    "office-addin-dev-certs": "^1.11.0",
    "office-addin-manifest": "^1.12.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "copy-webpack-plugin": "^11.0.0"
  }
}
